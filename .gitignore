# Dependencies
node_modules/
packages/*/node_modules/

# Build output
dist/
build/
packages/*/dist/

# Packed tarballs. `npm run pack` writes these (dist/tarballs by default, the
# repository root when --out-dir is omitted), and packages/sdk-supplier and the
# root both had one committed by accident.
*.tgz

# Coverage reports
coverage/
.nyc_output/

# TypeScript incremental compile info
*.tsbuildinfo

# Generator and build logs. scripts/generate-openapi.sh writes gen.log and
# output.log at the root and a per-run log under logs/.
*.log
logs/

# IDE / editor artifacts
.idea/
.vscode/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# OpenAPI generator temporary artifacts
.openapi-generator/
# ...but .openapi-generator-ignore is NOT an artifact - it is what stops the
# generator overwriting hand-maintained files, so it must stay tracked.
!.openapi-generator-ignore

# Environment
.env
.env.local
.env.*
